# ==========================================
# GTA Liberty City Stories PC - .gitignore
# Never commit game data, binaries or anything derived from them (AGENTS.md).
# ==========================================

# Game data, ROMs, APKs, IPAs, WADs and archives of them
*.ipa
*.apk
*.apks
*.apkm
*.xapk
*.obb
*.wad
*.iso
*.cso
*.zip
*.7z
*.rar

# Binaries and compiled libraries
*.exe
*.dll
*.so
*.so.*
*.dylib
*.elf
lcs_runtime
gtalcs/lcs_runtime
gtalcs.zip

# Proprietary extracted game files.
# gtalcs/ and modloader/ are junctions to the user's install on the dev machine:
# their few tracked files (port metadata) are marked skip-worktree locally.
/assets/
/gtalcs/
/modloader/
extracted/
extracted_ipa/
extracted_apk/
converted_textures/
/Grand Theft Auto - Liberty City Stories (USA)/
/Tradução Definitiva GTA LCS Android/
/Upscaled LCS Artworks/

# Game imagery used by the launcher (extracted/upscaled from the game, or game maps)
launcher/assets/characters/
launcher/assets/characters_orig/
launcher/assets/mainmenu/
launcher/assets/menu_backdrop.png
launcher/assets/liberty_city_hd_map.png
/*.jpg
/*.webp

# User data, saves and runtime settings
*.b
*.set
logs/
userdata/
saves/
/lcs.ini
/launcher.ini
/testwrite

# Build directories
/build/
/Release/
bin/
out/
dist/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Object and compiler files
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp
__pycache__/
*.pyc

# Diagnostics and agent scratch
/scratch/
.maestro-traces/

# IDE and system
.vs/
.vscode/
.idea/
CMakeSettings.json
CMakeUserPresets.json
*.suo
*.user
Thumbs.db
.DS_Store
